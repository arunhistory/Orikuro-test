---
/* 旧トップの .toast と同じ実効値。全ページのサービス入口が共通利用する。 */
---
<div class="toast" role="status" aria-live="polite" data-toast>このリンクは仮設置です</div>
<style>
.toast{
  position:fixed;
  left:50%;
  bottom:26px;
  z-index:100;
  transform:translate(-50%,20px);
  padding:12px 16px;
  border:1px solid var(--color-toast-border);
  background:var(--color-toast-background);
  backdrop-filter:blur(12px);
  font-size:12px;
  opacity:0;
  pointer-events:none;
  transition:.2s;
}
.toast.is-visible{opacity:1;transform:translate(-50%,0)}
</style>
