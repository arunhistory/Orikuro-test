---
// メニュー：項目は data/navigation.ts から作る。ここに項目を直接書かない。
import { menuGroups, forSide } from '../data/navigation';
import { href, isCurrent, side } from '../data/url';

const pathname = Astro.url.pathname;
---
<div class="mobile-menu" id="site-menu" data-mobile-menu aria-label="サイトメニュー">
  <div class="menu-map">
    {menuGroups.map((group) => (
      <section class="menu-group">
        <p class="menu-group-label">{group.label}</p>
        {forSide(group.links, side).map((link) => (
          <a href={href(link.path)} aria-current={isCurrent(link.path, pathname) ? 'page' : undefined}>{link.label}</a>
        ))}
      </section>
    ))}
  </div>
</div>
