---
// 10-4: 旧 stream-test.html の入口本文を1文字も変えずに移行。本体・配信処理は作らない。
import BaseLayout from '../../layouts/BaseLayout.astro';
import { href } from '../../data/url';
---
<BaseLayout title="配信テスト" description="">
  <main class="service-test-main"><section class="service-test-wrap"><p class="service-gate-status" role="status" aria-live="polite" data-service-gate-status>利用準備を確認しています。</p><article class="service-test-card" data-service-content hidden><p class="service-test-kicker">STREAM TEST</p><h1>配信テスト</h1><p>同意確認と内部配送が完了しました。<br/>ここから配信テスト本体を実装します。</p><a class="service-test-home" href={href('/')}>ホームへ戻る</a></article></section></main>
  <script is:inline type="module" src={href('/assets/js/service-destination.js')}></script>
</BaseLayout>
<style>
:global(html:has(.service-test-main)){--bg:var(--color-form-background);--ink:var(--color-form-ink);--muted:var(--color-algorithm-muted);--line:var(--color-algorithm-card-border);--header:74px}*{box-sizing:border-box}:global(html:has(.service-test-main)),:global(body:has(.service-test-main)){margin:0;min-height:100%;background:var(--bg);color:var(--ink);font-family:var(--font-system-ui)}.service-test-main{min-height:100vh;display:grid;place-items:center;padding:calc(var(--header) + 40px) 20px 60px}.service-test-wrap{width:min(720px,100%);text-align:center}.service-gate-status{min-height:26px;margin:0 0 18px;color:var(--muted);font-weight:750}.service-test-card{background:var(--color-white);border:1px solid var(--line);border-radius:24px;padding:46px 28px;box-shadow:0 20px 70px var(--color-algorithm-card-shadow)}.service-test-kicker{margin:0 0 12px;color:var(--color-algorithm-kicker);font-size:11px;font-weight:850;letter-spacing:.18em}.service-test-card h1{margin:0 0 16px;font-size:clamp(34px,7vw,54px);letter-spacing:-.05em}.service-test-card p{margin:0;color:var(--muted);line-height:1.85}.service-test-home{display:inline-flex;margin-top:28px;align-items:center;justify-content:center;min-height:44px;padding:0 18px;border:1px solid var(--color-algorithm-home-border);border-radius:999px;color:var(--ink);text-decoration:none;font-weight:800}@media(max-width:760px){:global(html:has(.service-test-main)){--header:66px}.service-test-main{padding:calc(var(--header) + 28px) 14px 50px}.service-test-card{padding:36px 20px;border-radius:20px}}

:global(body:has(.service-test-main) .menu-button),
:global(body:has(.service-test-main) .mobile-menu),
:global(body:has(.service-test-main) .site-footer){display:none}
:global(body:has(.service-test-main) .page-brand){font-weight:800}

:global(body:has(.service-test-main)){font-feature-settings:normal}
</style>
