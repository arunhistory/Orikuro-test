---
// operator.html の運営者情報を原文のまま移行。
import DocumentLayout from '../../layouts/DocumentLayout.astro';
---
<DocumentLayout title="運営者情報" description="Original Create Project 運営者情報" kind="operator">

      <dl class="doc-operator-list">
        <div class="doc-operator-row">
          <dt>プロジェクト名</dt>
          <dd>Original Create</dd>
        </div>
        <div class="doc-operator-row">
          <dt>代表責任者</dt>
          <dd>ある〜ん</dd>
        </div>
        <div class="doc-operator-row">
          <dt>制作</dt>
          <dd>ある〜ん<br />由咲るい</dd>
        </div>
        <div class="doc-operator-row">
          <dt>関係者</dt>
          <dd>東狼 煉<br />ミト</dd>
        </div>
        <div class="doc-operator-row">
          <dt>拠点</dt>
          <dd>愛知県</dd>
        </div>
      </dl>
</DocumentLayout>
<style>
/* =========================================================
   Operator（operator.html）— 旧サイトと同じ見出し・情報一覧
   ========================================================= */
:global(.doc--operator .doc-title-block h1){
  font-size:clamp(30px,6vw,58px);
  letter-spacing:.02em;
  white-space:nowrap;
}
:global(.doc-operator-list){
  margin:0;
  border-top:1px solid var(--color-doc-rule-soft);
}
:global(.doc-operator-row){
  display:grid;
  grid-template-columns:minmax(140px,220px) 1fr;
  gap:28px;
  padding:22px 0;
  border-bottom:1px solid var(--color-doc-rule-soft);
}
:global(.doc-operator-row dt),
:global(.doc-operator-row dd){
  margin:0;
  font-size:clamp(15px,1.7vw,17px);
  line-height:1.9;
}
:global(.doc-operator-row dt){font-weight:600}
:global(.doc-operator-row dd){font-weight:400}
@media(max-width:760px){
  :global(.doc-operator-row){
    grid-template-columns:1fr;
    gap:6px;
    padding:20px 0;
  }
}
</style>
