---
// crowdfunding.html の表示と未設定リンクの無効状態を維持。
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="クラウドファンディング" description="Original Create Project クラウドファンディング">
  <main class="crowdfunding-main">
    <article class="crowdfunding-wrap">
      <h1>クラウドファンディング</h1>

      <div class="crowdfunding-summary">
        <section class="crowdfunding-stat">
          <p class="crowdfunding-label">目標金額</p>
          <p class="crowdfunding-value">50万円以上</p>
          <p class="crowdfunding-sub">最大500万円</p>
        </section>
        <section class="crowdfunding-stat">
          <p class="crowdfunding-label">期間</p>
          <p class="crowdfunding-value">12月31日まで</p>
        </section>
      </div>

      <section class="crowdfunding-notice">
        <h2>注意事項</h2>
        <p>クラウドファンディングは外部サイトにて実施いたします。</p>
        <p>支援条件、決済、キャンセル、リターンその他の事項については、外部サイトに記載された内容および規約に従ってください。</p>
        <p>ご支援の前に、必ず外部サイトの内容をご確認ください。</p>
        <p>当サイトでは、支援の受付および決済は行っておりません。</p>
      </section>

      <a class="crowdfunding-button is-pending" href="#" aria-disabled="true" data-placeholder-link>クラウドファンディングページへ ↗</a>
    </article>
  </main>
</BaseLayout>
<style>
.crowdfunding-main{
  width:min(1180px,calc(100% - var(--pad)*2));
  margin:0 auto;
  padding:clamp(72px,9vw,118px) 0 clamp(110px,13vw,160px);
}

.crowdfunding-wrap{width:min(760px,100%);margin:0 auto}

.crowdfunding-wrap>h1{
  margin:0 0 clamp(48px,6vw,72px);
  font-size:clamp(38px,5vw,64px);
  line-height:1.1;
  letter-spacing:-.05em;
}

.crowdfunding-summary{
  display:grid;
  grid-template-columns:repeat(2,minmax(0,1fr));
  gap:18px;
  margin-bottom:clamp(56px,8vw,88px);
}

.crowdfunding-stat{
  min-height:190px;
  padding:26px;
  border:1px solid var(--color-card-border);
  border-radius:14px;
  background:var(--color-card-frosted);
  backdrop-filter:blur(16px);
}

.crowdfunding-label{
  margin:0 0 26px;
  color:var(--color-muted);
  font-size:12px;
  font-weight:800;
  letter-spacing:.08em;
}

.crowdfunding-value{
  margin:0;
  font-size:clamp(28px,4vw,44px);
  font-weight:900;
  line-height:1.15;
  letter-spacing:-.045em;
}

.crowdfunding-sub{
  margin:12px 0 0;
  color:var(--color-muted);
  font-size:15px;
  font-weight:700;
}

.crowdfunding-notice{
  margin-bottom:clamp(44px,7vw,70px);
  padding-top:36px;
  border-top:1px solid var(--color-card-border);
}

.crowdfunding-notice h2{
  margin:0 0 28px;
  font-size:clamp(24px,3vw,34px);
  line-height:1.2;
  letter-spacing:-.04em;
}

.crowdfunding-notice p{
  margin:0 0 16px;
  font-size:clamp(15px,1.55vw,18px);
  line-height:1.9;
}

.crowdfunding-notice p:last-child{margin-bottom:0}

.crowdfunding-button{
  display:flex;
  align-items:center;
  justify-content:space-between;
  width:100%;
  min-height:62px;
  padding:18px 22px;
  border-radius:12px;
  background:var(--color-ink);
  color:var(--color-white);
  font-size:16px;
  font-weight:850;
  text-decoration:none;
}

.crowdfunding-button.is-pending{opacity:.72;cursor:default}

@media(max-width:760px){
  .crowdfunding-main{padding-top:56px}
  .crowdfunding-wrap>h1{margin-bottom:42px}
  .crowdfunding-summary{grid-template-columns:1fr}
  .crowdfunding-stat{min-height:0}
}
</style>
