;height:41px}:global(body:has(.home-page) .page-brand span){font-size:12px}.hero-content{padding-top:calc(var(--header) + 44px)}.hero-title{margin-top:auto;margin-bottom:70px;font-size:clamp(48px,14.7vw,95px);line-height:.9}.hero-word-2{margin-left:7vw}.hero-word-3{margin-left:0;font-size:.86em}.hero-bottom{align-items:center}.hero-bottom p{max-width:270px;font-size:14px}.round-link{width:88px;padding:17px 14px}.question-main{grid-template-columns:1fr}.question-title{font-size:clamp(46px,13vw,78px)}.question-hit{max-width:520px}.question-close{margin-top:120px}.launch{min-height:85svh}.launch-space{height:25vh}.launch-year{font-size:clamp(130px,38vw,280px)}.launch-label{text-align:left}.route-card{min-height:210px}.route-inner{padding-top:34px;padding-bottom:34px}.route-card h3{font-size:clamp(38px,10vw,66px)}.route-card p{font-size:13px}:global(body:has(.home-page) .site-footer){flex-direction:column}:global(body:has(.home-page) .footer-meta){align-items:flex-start}}@media(max-width:520px){:global(body:has(.home-page)){--cut:28px}:global(body:has(.home-page) .page-brand span){display:none}.hero-bottom{flex-direction:column;align-items:flex-start}.round-link{align-self:flex-end}.question-title{font-size:clamp(42px,12.5vw,64px)}.service-cloud{gap:7px}.service-cloud span{padding:9px 11px;font-size:11px}.question-close h3{font-size:clamp(46px,13.6vw,70px)}.route-card{min-height:220px}.route-inner{padding-left:24px;padding-right:24px}.route-left .route-inner{padding-left:52px}.route-right .route-inner{padding-right:52px}.route-topline{font-size:8px}.route-card h3{font-size:clamp(34px,10vw,52px)}.route-card p{margin-top:16px;font-size:12px;line-height:1.7}}@media(prefers-reduced-motion:reduce){:global(html:has(.home-page)){scroll-behavior:auto}:global(html:has(.home-page) *),:global(html:has(.home-page) *::before),:global(html:has(.home-page) *::after){animation-duration:.01ms;animation-iteration-count:1;transition-duration:.01ms;}.reveal{opacity:1;transform:none}}:global(body:has(.home-page)){
  --bg:var(--color-home-state-tint);
  --text:var(--color-home-monochrome-scene-foreground-white-pale);
  --muted:var(--color-home-monochrome-scene-foreground-white-pale-alpha62pct);
  --line:var(--color-toast-border);
