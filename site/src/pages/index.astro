ack{width:100%;overflow:hidden}.route-card{position:relative;display:block;min-height:clamp(190px,22vw,310px);margin-top:-1px;background:linear-gradient(115deg,var(--color-home-route-card-background),var(--color-home-foundation-route-card-surface-black-dark));border-top:1px solid var(--color-home-route-card-border-top);border-bottom:1px solid var(--color-home-route-card-border-top);transition:transform .35s ease,background .35s ease;isolation:isolate}.route-card:before{content:"";position:absolute;inset:0;opacity:.36;transition:.35s;z-index:-1}.route-card:nth-child(1):before,.route-card:nth-child(5):before{background:radial-gradient(circle at 80% 50%,var(--color-home-foundation-route-card-surface-violet-pale-alpha45pct),transparent 38%)}.route-card:nth-child(2):before,.route-card:nth-child(6):before{background:radial-gradient(circle at 20% 50%,var(--color-home-foundation-route-card-surface-cyan-pale-alpha34pct),transparent 38%)}.route-card:nth-child(3):before,.route-card:nth-child(7):before{background:radial-gradient(circle at 80% 50%,var(--color-home-foundation-route-card-surface-lime-pale-alpha28pct),transparent 38%)}.route-card:nth-child(4):before{background:radial-gradient(circle at 20% 50%,var(--color-home-route-card-border-top),transparent 38%)}.route-right{clip-path:polygon(0 0,calc(100% - var(--cut)) 0,100% 50%,calc(100% - var(--cut)) 100%,0 100%)}.route-left{clip-path:polygon(var(--cut) 0,100% 0,100% 100%,var(--cut) 100%,0 50%)}.route-inner{min-height:inherit;padding:clamp(28px,4vw,58px) clamp(32px,7vw,110px);display:flex;flex-direction:column;justify-content:center}.route-left .route-inner{padding-left:clamp(62px,11vw,180px)}.route-right .route-inner{padding-right:clamp(62px,11vw,180px)}.route-topline{display:flex;justify-content:space-between;gap:20px;margin-bottom:14px;color:var(--color-home-route-topline-color);font-size:9px;letter-spacing:.18em}.route-card h3{margin:0;width:max-content;max-width:100%;font-size:clamp(42px,7vw,104px);line-height:.92;lett