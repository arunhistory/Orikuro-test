---
import BaseLayout from '../layouts/BaseLayout.astro';
import { href } from '../data/url';
import { homeRoutes } from '../data/home-routes';
import announcements from '../data/announcements.json';
---
<BaseLayout title="Original Create Project" description="Original Create Project — 2027年始動予定">
  <div class="page-noise" aria-hidden="true"></div>
  <div class="home-page">
  <main>
    <section class="hero" id="top">
      <div class="hero-grid" aria-hidden="true"></div>
      <div class="hero-orb orb-a" aria-hidden="true"></div>
      <div class="hero-orb orb-b" aria-hidden="true"></div>
      <div class="hero-content">
        <p class="eyebrow">ORIGINAL CREATE / PROJECT SITE</p>
        <h1 class="hero-title" aria-label="オリジナル クリエイト プロジェクト">
          <span class="hero-word hero-word-1">オリジナル</span>
          <span class="hero-word hero-word-2">クリエイト</span>
          <span class="hero-word hero-word-3">プロジェクト</span>
        </h1>
        <div class="hero-bottom">
          <p>自由をカタチに未来をつくる</p>
          <a class="round-link" href={href('/#question')} aria-label="続きを読む"><span>SCROLL</span><span class="arrow">↘</span></a>
        </div>
      </div>
    </section>

    <section class="pressure" id="question">
      <div class="pressure-wall" aria-label="創作活動で増えていく行動">
        <p class="pressure-ghost g1" aria-hidden="true">アカウント</p>
        <p class="pressure-ghost g2" aria-hidden="true">アカウント</p>
        <p class="pressure-ghost g3" aria-hidden="true">アカウント</p>
        <p class="pressure-word p1 reveal">作品を作る</p>
        <p class="pressure-word p2 reveal">投稿する</p>
        <p class="pressure-word p3 reveal">配信する</p>
        <p class="pressure-word p4 reveal">売る</p>
        <p class="pressure-word p5 reveal">買う</p>
        <p class="pressure-word p6 reveal">交流する</p>
        <p class="pressure-word p7 reveal">依頼する</p>
        <p class="pressure-word p8 reveal">受注する</p>
        <p class="pressure-word p9 reveal">発送する</p>
        <p class="pressure-word p10 reveal">匿名発送する</p>
        <p class="pressure-word p11 reveal">告知する</p>
        <p class="pressure-word p12 reveal">宣伝する</p>
        <p class="pressure-word p13 reveal">プロフィールを書く</p>
        <p class="pressure-word p14 reveal">リンクを貼る</p>
        <p class="pressure-word p15 reveal">アカウントを作る</p>
        <p class="pressure-word p16 reveal">ログインする</p>
        <p class="pressure-word p17 reveal">切り替える</p>
        <p class="pressure-word p18 reveal">またログインする</p>
        <p class="pressure-word p19 reveal">登録する</p>
        <p class="pressure-word p20 reveal">認証する</p>
        <p class="pressure-word p21 reveal">確認する</p>
        <p class="pressure-word p22 reveal">更新する</p>
        <p class="pressure-word p23 reveal">管理する</p>
        <p class="pressure-word p24 reveal">分からない</p>
        <p class="pressure-word p25 reveal">上手くいかない</p>
      </div>

      <div class="pressure-question section-pad">
        <p class="pressure-lead reveal">そのたびに</p>
        <h2 class="reveal">また別のアカウントを<br />作っていませんか？</h2>
      </div>

      <div class="service-rush" aria-label="活動で利用されるサービスの例">
        <div class="service-rush-line rush-a reveal">
          <span>X</span><i>｜</i><span>Discord</span><i>｜</i><span>配信媒体(※)</span><i>｜</i><span>pixiv</span>
        </div>
        <div class="service-rush-line rush-b reveal">
          <span>note</span><i>｜</i><span>アイビスペイント</span><i>｜</i><span>ココナラ</span><i>｜</i><span>その他サイト</span>
        </div>
        <p class="service-note reveal">※YouTube｜IRIAM｜REALITY｜17LIVE｜TikTok LIVE等があります</p>
      </div>

      <div class="pressure-close">
        <p class="pressure-fact reveal">活動を広げるほど使うサービスも管理するものも増えていく</p>
        <h3 aria-label="今の活動を限界だと感じませんか？">
          <span class="reveal">今の活動を</span>
          <span class="reveal">限界だと</span>
          <span class="reveal">感じませんか？</span>
        </h3>
        <p class="answer-line reveal">オリクロはそんな常識をぶち壊します</p>
      </div>
    </section>

    <section class="launch" id="launch">
      <div class="launch-core" aria-label="2027年 始動">
        <h2 class="launch-year-lock">
          <span class="launch-year-num">2027</span><span class="launch-year-unit">年</span>
        </h2>
        <div class="launch-storm" aria-hidden="true">
          <i></i><i></i><i></i><i></i><i></i><i></i>
        </div>
        <p class="launch-start" data-text="始動" aria-label="始動">
          <span class="launch-start-char launch-start-left">始</span>
          <span class="launch-start-char launch-start-right">動</span>
        </p>
      </div>
    </section>

    <section class="link-zone" id="links">
      <div class="link-zone-head section-pad">
        <h2 class="link-zone-title reveal">乞うご期待</h2>
      </div>

      <div class="link-stack">
        {homeRoutes.map((route) => (
          <a class={`route-card route-${route.side} reveal`} href={href(route.path)} data-service-entry={route.serviceEntry}>
            <div class="route-inner">
              <div class="route-topline"><span>{route.number}</span></div>
              <h3>{route.heading}</h3>
              <p>{route.description.map((line,index) => <Fragment>{index > 0 && <br />}{line}</Fragment>)}</p>
            </div>
          </a>
        ))}
      </div>
    </section>
  </main>
  <section class="home-updates" aria-label="お知らせと公式X">
    <div class="updates-inner">
      <section class="updates-stream updates-news" aria-label="お知らせ">
        <div class="updates-stream-head">
          <p class="updates-label">INFORMATION</p>
          <h2>お知らせ</h2>
        </div>
        <div class="updates-post-list">
          {announcements.map((notice) => (
            <article class="updates-post">
              <time datetime={notice.date}>{notice.displayDate}</time>
              <div><strong>{notice.title}</strong><p>{notice.source}</p></div>
            </article>
          ))}
        </div>
      </section>

      <section class="updates-stream updates-x-stream" aria-label="公式Xの投稿">
        <div class="updates-stream-head updates-x-head">
          <p class="updates-label">OFFICIAL X</p>
          <h2>公式 X</h2>
        </div>
        <div class="x-timeline-slot" data-x-feed aria-live="polite">
          <div class="x-feed-state">
            <p class="x-feed-state-title">公式Xの投稿を準備中です</p>
            <p class="x-feed-state-text">登録された投稿をここに表示します。</p>
          </div>
        </div>
        <a class="x-profile-link" href="https://x.com/orikuro_2027" target="_blank" rel="noopener noreferrer">Xで見る ↗</a>
      </section>
    </div>
  </section>
  </div>
  <script src="../scripts/home.ts"></script>
  <script src="../scripts/x-feed.ts"></script>
</BaseLayout>
<style>
:global(body:has(.home-page)){--bg:var(--color-home-canvas-tint);--text:var(--color-home-foreground);--muted:var(--color-home-muted-foreground);--line:var(--color-toast-border);--paper:var(--color-home-paper-surface);--ink:var(--color-home-dark-ink);--acid:var(--color-home-acid-highlight);--violet:var(--color-home-violet-highlight);--cyan:var(--color-home-cyan-highlight);--pad:clamp(20px,4vw,64px);--header:72px;--cut:clamp(34px,7vw,110px)}*{box-sizing:border-box}:global(html:has(.home-page)){scroll-behavior:smooth;background:var(--bg)}:global(body:has(.home-page)){margin:0;background:var(--bg);color:var(--text);font-family:var(--font-sans);overflow-x:hidden}a{color:inherit;text-decoration:none}button{font:inherit}.page-noise{position:fixed;inset:0;pointer-events:none;z-index:99;opacity:.07;background-image:repeating-radial-gradient(circle at 0 0,transparent 0,var(--color-home-page-noise-background-image) 1px,transparent 2px,transparent 4px)}:global(body:has(.home-page) .page-header){position:fixed;inset:0 0 auto 0;height:var(--header);z-index:50;display:flex;align-items:center;justify-content:space-between;padding:0 var(--pad);transition:.3s}:global(body:has(.home-page) .page-header.is-scrolled){background:var(--color-home-is-scrolled-background);backdrop-filter:blur(16px);border-bottom:1px solid var(--line)}:global(body:has(.home-page) .page-brand){display:flex;align-items:center;gap:11px;font-weight:800}:global(body:has(.home-page) .page-header .brand-symbol){width:46px;height:46px;object-fit:contain;display:block;background:var(--color-white);border-radius:8px}:global(body:has(.home-page) .page-brand span){font-size:14px;letter-spacing:-.01em}.desktop-nav{display:flex;gap:clamp(18px,3vw,38px);font-size:11px;letter-spacing:.16em}.desktop-nav a{opacity:.68;transition:.2s}.desktop-nav a:hover{opacity:1}:global(body:has(.home-page) .page-header .menu-button){display:none;width:42px;height:42px;border:0;background:transparent;position:relative}:global(body:has(.home-page) .page-header .menu-button span){position:absolute;left:9px;right:9px;height:1px;background:var(--color-white);transition:.25s}:global(body:has(.home-page) .page-header .menu-button span:first-child){top:16px}:global(body:has(.home-page) .page-header .menu-button span:last-child){top:25px}:global(body:has(.home-page) .page-header .menu-button.is-open span:first-child){top:21px;transform:rotate(45deg)}:global(body:has(.home-page) .page-header .menu-button.is-open span:last-child){top:21px;transform:rotate(-45deg)}.mobile-menu{position:fixed;inset:var(--header) 0 auto 0;z-index:45;display:none;padding:18px var(--pad) 28px;background:var(--color-home-mobile-menu-background);backdrop-filter:blur(18px);border-bottom:1px solid var(--line)}.mobile-menu.is-open{display:grid}.mobile-menu a{padding:18px 0;border-bottom:1px solid var(--line);font-size:28px;letter-spacing:-.03em}.section-pad{padding:clamp(88px,12vw,170px) var(--pad)}.section-index,.eyebrow{margin:0;font-size:10px;font-weight:800;letter-spacing:.2em;color:var(--muted)}.hero{min-height:100svh;position:relative;overflow:hidden;border-bottom:1px solid var(--line)}.hero-grid{position:absolute;inset:0;background-image:linear-gradient(var(--color-home-page-noise-background-image) 1px,transparent 1px),linear-gradient(90deg,var(--color-home-page-noise-background-image) 1px,transparent 1px);background-size:64px 64px;mask-image:linear-gradient(to bottom,var(--color-home-hero-grid-mask-image) 25%,transparent 90%)}.hero-orb{position:absolute;width:min(62vw,760px);aspect-ratio:1;border-radius:50%;pointer-events:none}.orb-a{right:-18vw;top:-18vw;background:radial-gradient(circle at 30% 30%,var(--color-home-orb-a-background),var(--color-home-foundation-orb-a-glow-violet-pale-alpha28pct) 48%,transparent 72%);animation:floatA 12s ease-in-out infinite alternate}.orb-b{left:-30vw;bottom:-42vw;background:radial-gradient(circle at 60% 40%,var(--color-home-orb-b-background),var(--color-home-foundation-orb-b-glow-violet-pale-alpha