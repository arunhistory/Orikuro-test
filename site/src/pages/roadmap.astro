---
// roadmap.html の本文を原文のまま移行。旧APIの表示処理だけ独立。
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="ロードマップ" description="Original Create Project ロードマップ">
  <main class="roadmap-main">
    <article class="roadmap-wrap">
      <h1>ロードマップ</h1>

      <ol class="roadmap-list" aria-label="Original Create Project ロードマップ">
        <li><span class="roadmap-number">01</span><span class="roadmap-title">情報収集</span></li>
        <li><span class="roadmap-number">02</span><span class="roadmap-title">各種申請</span></li>
        <li><span class="roadmap-number">03</span><span class="roadmap-title">制作開始</span></li>
        <li><span class="roadmap-number">04</span><span class="roadmap-title">αテスト</span></li>
        <li><span class="roadmap-number">05</span><span class="roadmap-title">βテスト</span></li>
        <li><span class="roadmap-number">06</span><span class="roadmap-title">事業説明</span></li>
        <li><span class="roadmap-number">07</span><span class="roadmap-title">公開準備</span></li>
        <li><span class="roadmap-number">08</span><span class="roadmap-title">公開開始</span></li>
      </ol>

      <section class="roadmap-current" data-roadmap-current>
        <p class="roadmap-current-label">現在の状況</p>
        <p class="roadmap-current-text" data-roadmap-status>未接続</p>
        <time class="roadmap-current-date" data-roadmap-updated>最終更新 未接続</time>
      </section>
    </article>
  </main>
  <script src="../scripts/roadmap.ts"></script>
</BaseLayout>
<style>
.roadmap-main{
  width:min(1180px,calc(100% - var(--pad)*2));
  margin:0 auto;
  padding:clamp(72px,9vw,118px) 0 clamp(110px,13vw,160px);
}

.roadmap-wrap{width:min(860px,100%);margin:0 auto}

.roadmap-wrap>h1{
  margin:0 0 clamp(48px,6vw,72px);
  font-size:clamp(38px,5vw,64px);
  line-height:1.1;
  letter-spacing:-.05em;
}

.roadmap-list{
  list-style:none;
  margin:0;
  padding:0;
  border-top:1px solid var(--color-section-divider);
}

.roadmap-list li{
  display:grid;
  grid-template-columns:clamp(48px,7vw,76px) 1fr;
  align-items:center;
  gap:clamp(12px,2vw,24px);
  min-height:clamp(82px,10vw,112px);
  padding:18px 0;
  border-bottom:1px solid var(--color-section-divider);
}

.roadmap-number{
  color:var(--color-roadmap-meta);
  font-size:12px;
  font-weight:850;
  letter-spacing:.12em;
}

.roadmap-title{
  color:var(--color-ink);
  font-size:clamp(24px,3.2vw,38px);
  font-weight:900;
  line-height:1.2;
  letter-spacing:-.04em;
}

.roadmap-current{
  margin-top:clamp(84px,11vw,132px);
  padding:clamp(28px,4vw,42px);
  border:1px solid var(--color-section-divider);
  border-radius:14px;
  background:var(--color-roadmap-current-background);
  box-shadow:0 18px 56px var(--color-roadmap-shadow);
  backdrop-filter:blur(18px);
}

.roadmap-current-label{
  margin:0 0 18px;
  color:var(--color-muted);
  font-size:12px;
  font-weight:850;
  letter-spacing:.10em;
}

.roadmap-current-text{
  margin:0;
  color:var(--color-ink);
  font-size:clamp(20px,2.6vw,30px);
  font-weight:850;
  line-height:1.55;
  letter-spacing:-.03em;
}

.roadmap-current-date{
  display:block;
  margin-top:22px;
  color:var(--color-roadmap-meta);
  font-size:12px;
  font-weight:700;
  letter-spacing:.04em;
}

@media(max-width:760px){
  .roadmap-main{padding-top:56px}
  .roadmap-wrap>h1{margin-bottom:44px}
  .roadmap-list li{grid-template-columns:46px 1fr;min-height:78px}
  .roadmap-current{margin-top:72px;padding:24px 20px}
}
</style>
