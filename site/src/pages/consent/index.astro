---
// 旧 test.html の本文は変更せず、移動先リンクのみ href() に移行。
import BaseLayout from '../../layouts/BaseLayout.astro';
import { href } from '../../data/url';
---
<BaseLayout title="利用前の確認" description="Original Create Project サービス利用前の確認">
  <main class="consent-main">
    <section class="consent-wrap">
      <p class="consent-kicker">SERVICE CONSENT</p>
      <h1>ご利用前の確認</h1>
      <p class="consent-lead">サービスを利用する前に、必要事項の入力と各ポリシーへの同意をお願いします。</p>

      <form class="consent-card" data-test-form novalidate>
        <div class="consent-field">
          <label for="service-full-name">本名</label>
          <input id="service-full-name" name="fullName" type="text" autocomplete="name" maxlength="100" required />
          <p class="consent-note">法令上必要となる同意記録の特定に使用します。</p>
        </div>

        <div class="consent-field">
          <label for="service-email">メールアドレス</label>
          <input id="service-email" name="email" type="email" autocomplete="email" inputmode="email" required />
          <p class="consent-note">実際に使用しているメールアドレスを入力してください。</p>
        </div>

        <div class="consent-checks">
          <label class="consent-check"><input type="checkbox" name="terms" required /><span><a href={href('/legal/terms/')} target="_blank" rel="noopener noreferrer">利用規約</a>に同意する</span></label>
          <label class="consent-check"><input type="checkbox" name="privacy" required /><span><a href={href('/legal/privacy/')} target="_blank" rel="noopener noreferrer">プライバシーポリシー</a>に同意する</span></label>
          <label class="consent-check"><input type="checkbox" name="cookie" required /><span><a href={href('/legal/cookie/')} target="_blank" rel="noopener noreferrer">Cookieポリシー</a>に同意する</span></label>
        </div>

        <button class="consent-submit" type="submit" disabled>同意して進む</button>
        <p class="consent-status" role="status" aria-live="polite" data-test-status></p>
        <p class="consent-timeout">10分間操作がない場合はタイムアウトします。タイムアウト後に操作すると案内を表示し、ホームページへ戻ります。</p>
      </form>
    </section>
  </main>
  <script is:inline type="module" src={href('/assets/js/input-router.js')}></script>
</BaseLayout>
<style>
:global(html:has(.consent-main)){--ink:var(--color-consent-main-html-has-consent-main-ink-1);--muted:var(--color-consent-main-html-has-consent-main-muted-2);--line:var(--color-consent-main-html-has-consent-main-line-3);--bg:var(--color-consent-main-html-has-consent-main-bg-4);--panel:var(--crowdfunding-button-color);--accent:var(--color-consent-main-html-has-consent-main-accent-6);--header:74px}*{box-sizing:border-box}:global(html:has(.consent-main)),:global(body:has(.consent-main)){margin:0;min-height:100%;background:var(--bg);color:var(--ink);font-family:var(--font-sans)}.consent-main{min-height:calc(100vh - var(--header));padding:calc(var(--header) + 52px) 20px 80px}.consent-wrap{width:min(680px,100%);margin:0 auto}.consent-kicker{margin:0 0 10px;color:var(--color-consent-main-consent-kicker-color-7);font-size:11px;font-weight:800;letter-spacing:.18em}.consent-wrap h1{margin:0 0 12px;font-size:clamp(30px,6vw,46px);line-height:1.15;letter-spacing:-.04em}.consent-lead{margin:0 0 30px;color:var(--muted);line-height:1.8}.consent-card{background:var(--panel);border:1px solid var(--line);border-radius:22px;padding:28px;box-shadow:0 18px 60px var(--color-consent-main-consent-card-color-8)}.consent-field{display:grid;gap:8px;margin-bottom:22px}.consent-field label{font-weight:800;font-size:14px}.consent-field input{width:100%;height:50px;border:1px solid var(--color-consent-main-consent-field-input-color-9);border-radius:12px;background:var(--crowdfunding-button-color);padding:0 14px;font:inherit;color:var(--ink);outline:none}.consent-field input:focus{border-color:var(--color-consent-main-consent-field-input-focus-color-11);box-shadow:0 0 0 3px var(--color-consent-main-consent-field-input-focus-color-12)}.consent-note{margin:2px 0 0;color:var(--color-consent-main-consent-kicker-color-7);font-size:12px;line-height:1.6}.consent-checks{display:grid;gap:13px;margin:8px 0 24px}.consent-check{display:flex;align-items:flex-start;gap:11px;font-size:14px;line-height:1.6}.consent-check input{width:18px;height:18px;margin:2px 0 0;flex:0 0 auto}.consent-check a{color:var(--color-consent-main-consent-check-a-color-14);text-decoration:underline;text-underline-offset:3px}.consent-submit{width:100%;min-height:52px;border:0;border-radius:13px;background:var(--accent);color:var(--crowdfunding-button-color);font:inherit;font-weight:850;letter-spacing:.03em;cursor:pointer}.consent-submit:disabled{opacity:.45;cursor:not-allowed}.consent-status{min-height:24px;margin:14px 0 0;text-align:center;color:var(--color-consent-main-consent-status-color-16);font-size:13px;font-weight:700}.consent-timeout{margin:20px 0 0;padding:14px 16px;border:1px dashed var(--color-consent-main-consent-timeout-color-17);border-radius:12px;color:var(--color-consent-main-consent-timeout-color-18);font-size:12px;line-height:1.7}@media(max-width:760px){:global(html:has(.consent-main)){--header:66px}.consent-main{padding:calc(var(--header) + 34px) 14px 64px}.consent-card{padding:22px 18px;border-radius:18px}}

:global(body:has(.consent-main) .mobile-menu .menu-group:nth-child(2)){display:none}
</style>
