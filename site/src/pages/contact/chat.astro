---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { href } from '../../data/url';
---
<BaseLayout title="お問い合わせチャット" description="">
  <meta slot="head" name="robots" content="noindex,nofollow,noarchive" />
  <meta slot="head" name="referrer" content="no-referrer" />
  <main class="chat-main">
    <section class="chat-shell" data-chat-shell>
      <div class="chat-titlebar">
        <div>
          <p class="chat-eyebrow">PRIVATE SUPPORT</p>
          <h1>お問い合わせチャット</h1>
        </div>
        <div class="chat-ticket" data-ticket-code>認証確認中</div>
      </div>

      <div class="chat-ticket-notice">
        <strong>受付番号：<span data-ticket-code-notice>確認中</span></strong>
        <span>この番号は、このお問い合わせに戻る際に必要です。控えておいてください。</span>
      </div>

      <div class="chat-security-note">
        Discordアカウント認証済みの専用チャットです。会話はDiscord上の専用プライベートチャンネルを正本としてWebに表示します。
      </div>

      <div class="chat-log" data-chat-log role="log" aria-live="polite" aria-relevant="additions text">
        <div class="chat-loading" data-chat-loading>お問い合わせを準備しています…</div>
      </div>

      <section class="resolution-panel" data-resolution-panel hidden>
        <p>このお問い合わせは解決しましたか？</p>
        <div class="resolution-actions">
          <button type="button" class="resolution-yes" data-resolution-yes>はい</button>
          <button type="button" class="resolution-no" data-resolution-no>いいえ</button>
        </div>
      </section>

      <form class="chat-compose" data-chat-form>
        <label class="sr-only" for="chat-message">お問い合わせ内容</label>
        <textarea id="chat-message" data-chat-input maxlength="1000" rows="3" placeholder="メッセージを入力" required></textarea>
        <div class="chat-compose-row">
          <span data-message-count>0 / 1000</span>
          <button type="submit" data-chat-send>送信</button>
        </div>
      </form>

      <p class="chat-status" data-chat-status role="status" aria-live="polite"></p>
    </section>

    <section class="chat-closed" data-chat-closed hidden>
      <p class="chat-eyebrow">SUPPORT CHAT</p>
      <h1 data-closed-title>お問い合わせは終了しました</h1>
      <p data-closed-message>このお問い合わせチャットは終了しました。</p>
      <a href={href('/contact/')}>お問い合わせページへ戻る</a>
    </section>
  </main>
  <script src="../../scripts/contact-chat.js"></script>
</BaseLayout>
<style>
:global(body:has(.chat-main)){margin:0;background:var(--color-chat-main--global-body-has-chat-main--fill-1);color:var(--color-contact-main--contact-chat-start-fill-11)}.chat-header{display:flex;align-items:center;justify-content:space-between;padding-right:22px}.chat-header-label{font-size:11px;font-weight:850;letter-spacing:.16em;color:var(--color-chat-main--chat-header-label-fill-3)}.chat-main{min-height:100vh;padding:calc(var(--header,74px) + 26px) 14px 40px}.chat-shell,.chat-closed{width:min(900px,100%);margin:0 auto;background:var(--crowdfunding-button-color);border:1px solid var(--color-chat-main--chat-shell-fill-5);border-radius:24px;box-shadow:0 20px 60px var(--color-chat-main--chat-shell-shadow-6);overflow:hidden}.chat-titlebar{display:flex;align-items:flex-start;justify-content:space-between;gap:20px;padding:26px 28px 18px;border-bottom:1px solid var(--color-chat-main--chat-titlebar-bottom-7)}.chat-eyebrow{margin:0 0 7px;font-size:10px;font-weight:850;letter-spacing:.18em;color:var(--color-chat-main--chat-eyebrow-fill-8)}.chat-titlebar h1,.chat-closed h1{margin:0;font-size:clamp(23px,4vw,32px)}.chat-ticket{flex:none;padding:8px 11px;border-radius:999px;background:var(--color-chat-main--chat-ticket-fill-9);color:var(--color-chat-main--chat-ticket-fill-10);font-size:12px;font-weight:800;letter-spacing:.04em}.chat-ticket-notice{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:14px 28px;background:var(--color-chat-main--chat-ticket-notice-fill-11);border-bottom:1px solid var(--color-chat-main--chat-ticket-notice-bottom-12);color:var(--color-chat-main--chat-ticket-notice-fill-13);font-size:12px;line-height:1.7}.chat-ticket-notice strong{font-size:13px;white-space:nowrap}.chat-ticket-notice span:last-child{color:var(--color-chat-main-chat-ticket-notice-span-last-child-fill-14)}.chat-security-note{padding:13px 28px;background:var(--color-chat-main--chat-security-note-fill-15);border-bottom:1px solid var(--color-chat-main--chat-titlebar-bottom-7);color:var(--color-chat-main--chat-security-note-fill-17);font-size:12px;line-height:1.7}.chat-log{height:min(56vh,560px);min-height:360px;overflow-y:auto;padding:24px;background:var(--color-chat-main--chat-log-fill-18);scroll-behavior:smooth}.chat-loading{text-align:center;color:var(--color-chat-main--chat-loading-fill-19);padding:50px 10px}.chat-message{display:flex;margin:10px 0}.chat-message.user{justify-content:flex-end}.chat-message.operator,.chat-message.system,.chat-message.resolution,.chat-message.discord{justify-content:flex-start}.chat-bubble{max-width:min(75%,620px);padding:12px 15px;border-radius:17px;white-space:pre-wrap;overflow-wrap:anywhere;line-height:1.65;font-size:14px}.chat-message.user .chat-bubble{background:var(--color-contact-main--contact-chat-start-fill-11);color:var(--crowdfunding-button-color);border-bottom-right-radius:5px}.chat-message.operator .chat-bubble{background:var(--crowdfunding-button-color);border:1px solid var(--color-chat-main--chat-message-operator-chat-bubble-fill-23);color:var(--color-chat-main--chat-message-operator-chat-bubble-fill-24);border-bottom-left-radius:5px}.chat-message.system .chat-bubble,.chat-message.resolution .chat-bubble{background:var(--color-chat-main--chat-message-system-chat-bubble-fill-25);color:var(--color-chat-main--chat-message-system-chat-bubble-fill-26);font-size:12px}.chat-message.discord .chat-bubble{background:var(--color-chat-main--chat-message-discord-chat-bubble-fill-27);color:var(--color-chat-main--chat-message-discord-chat-bubble-fill-28);border:1px solid var(--color-chat-main--chat-message-discord-chat-bubble-fill-29)}.chat-meta{display:block;margin-top:6px;opacity:.65;font-size:10px}.resolution-panel{padding:18px 28px;border-top:1px solid var(--color-contact-main--contact-resume-top-17);background:var(--color-chat-main--resolution-panel-fill-31)}.resolution-panel p{margin:0 0 12px;font-weight:850}.resolution-actions{display:grid;grid-template-columns:1fr 1fr;gap:10px}.resolution-actions button{min-height:48px;border-radius:12px;font-size:15px;font-weight:850;cursor:pointer}.resolution-yes{border:0;background:var(--color-chat-main--resolution-yes-fill-32);color:var(--crowdfunding-button-color)}.resolution-no{border:1px solid var(--color-chat-main--resolution-no-fill-34);background:var(--crowdfunding-button-color);color:var(--color-chat-main--resolution-no-fill-36)}.resolution-actions button:disabled{opacity:.55;cursor:wait}.chat-compose{padding:18px 22px 16px;border-top:1px solid var(--color-chat-main--chat-compose-top-37);background:var(--crowdfunding-button-color)}.chat-compose textarea{box-sizing:border-box;width:100%;min-height:90px;resize:vertical;border:1px solid var(--color-consent-main-consent-field-input-color-9);border-radius:14px;padding:13px 14px;font:inherit;line-height:1.55;outline:none}.chat-compose textarea:focus{border-color:var(--color-chat-main--chat-compose-textarea-focus-color-40);box-shadow:0 0 0 3px var(--color-chat-main--chat-compose-textarea-focus-shadow-41)}.chat-compose-row{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-top:10px}.chat-compose-row span{color:var(--color-chat-main--chat-compose-row-span-fill-42);font-size:12px}.chat-compose-row button{min-width:100px;min-height:44px;border:0;border-radius:12px;background:var(--color-contact-main--contact-chat-start-fill-11);color:var(--crowdfunding-button-color);font-weight:850;cursor:pointer}.chat-compose-row button:disabled{opacity:.55;cursor:wait}.chat-status{min-height:1.4em;margin:0;padding:0 22px 18px;color:var(--color-chat-main--chat-status-fill-45);font-size:13px}.chat-closed{box-sizing:border-box;padding:42px 28px;text-align:center}.chat-closed p:not(.chat-eyebrow){color:var(--color-chat-main--chat-closed-p-not-chat-eyebrow--fill-46);line-height:1.8}.chat-closed a{display:inline-flex;margin-top:12px;min-height:46px;padding:0 20px;align-items:center;border-radius:12px;background:var(--color-contact-main--contact-chat-start-fill-11);color:var(--crowdfunding-button-color);text-decoration:none;font-weight:800}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}@media(max-width:640px){.chat-header-label{display:none}.chat-main{padding-left:8px;padding-right:8px}.chat-shell{border-radius:18px}.chat-titlebar{padding:21px 18px 15px;display:block}.chat-ticket{display:inline-block;margin-top:12px}.chat-ticket-notice{padding:12px 18px;display:block}.chat-ticket-notice strong,.chat-ticket-notice span:last-child{display:block}.chat-ticket-notice span:last-child{margin-top:3px}.chat-security-note{padding:12px 18px}.chat-log{padding:16px 12px;min-height:320px;height:55vh}.chat-bubble{max-width:86%}.resolution-panel{padding:16px 18px}.chat-compose{padding:14px 14px 12px}.chat-status{padding:0 14px 14px}}
:global(body:has(.chat-main) .menu-button),
:global(body:has(.chat-main) .mobile-menu),
:global(body:has(.chat-main) .site-footer){display:none}
:global(body:has(.chat-main) .page-header){padding-right:22px}
:global(body:has(.chat-main) .page-header::after){
  content:"SUPPORT CHAT";
  color:var(--color-chat-main--chat-header-label-fill-3);
  font-size:11px;
  font-weight:850;
  letter-spacing:.16em;
}
@media(max-width:640px){
  :global(body:has(.chat-main) .page-header::after){display:none}
}

</style>
