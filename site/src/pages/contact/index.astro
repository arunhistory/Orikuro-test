---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { href } from '../../data/url';
---
<BaseLayout title="お問い合わせ" description="Original Create Project お問い合わせ">
  <main class="contact-main">
    <article class="contact-wrap">
      <div class="contact-head">
        <p class="contact-kicker">SUPPORT / CHAT</p>
        <h1>お問い合わせ</h1>
        <p class="contact-lead">Original Createへのお問い合わせは、Webチャットから受け付けています。</p>
      </div>

      <div class="contact-notes">
        <p>Original Create Projectに関するお問い合わせ以外には、返答いたしかねます。</p>
        <p>氏名・住所・電話番号など、不要な個人情報は入力しないでください。</p>
        <p>迷惑行為、連続送信、なりすまし等は禁止します。</p>
        <p>お問い合わせは解決後、もしくはユーザー様無回答で削除される場合がございます。ご了承ください。</p>
      </div>

      <section class="contact-chat-card" aria-labelledby="chat-title">
        <h2 id="chat-title">チャットでお問い合わせ</h2>
        <p><strong>お問い合わせチャットの利用にはDiscordアカウントが必要です。</strong></p>
        <p>認証後のお問い合わせは、Original Createのサイト内チャットで行われます。</p>
        <button class="contact-chat-start" type="button" data-chat-start disabled>チャットの準備を確認しています…</button>
        <p class="contact-status" role="status" aria-live="polite" data-contact-status></p>

        <div class="contact-resume">
          <h3>お問い合わせに戻る</h3>
          <p>進行中のお問い合わせへ戻る場合は、最初に表示された受付番号を入力してください。</p>
          <form class="contact-resume-form" data-resume-form>
            <label for="support-ticket-code">受付番号</label>
            <div class="contact-resume-row">
              <input id="support-ticket-code" data-resume-input type="text" inputmode="text" autocomplete="off" autocapitalize="characters" spellcheck="false" maxlength="11" placeholder="OC-XXXXXXXX" aria-describedby="support-ticket-help" />
              <button type="submit" data-resume-button disabled>お問い合わせに戻る</button>
            </div>
            <p id="support-ticket-help" class="contact-resume-help">受付番号と、開始時に使用したDiscordアカウントの両方を確認します。</p>
          </form>
          <p class="contact-resume-status" role="status" aria-live="polite" data-resume-status></p>
        </div>
      </section>

      <a class="contact-x" href="https://x.com/orikuro_2027?s=11&t=oe3JylyzOH2-p5yGov2e9g" target="_blank" rel="noopener noreferrer">
        <span class="contact-x-row"><span class="contact-x-icon" aria-hidden="true">X</span><span class="contact-x-title">公式 X 受付中</span></span>
        <span class="contact-x-note">XのDMからもお問い合わせできます</span>
      </a>
    </article>
  </main>
  <script src="../../scripts/contact.js"></script>
</BaseLayout>
<style>
:global(body:has(.contact-main)){margin:0;background:var(--color-page);color:var(--color-contact-fill)}.contact-main{min-height:70vh;padding:calc(var(--header) + 48px) 18px 80px}.contact-wrap{width:min(880px,100%);margin:0 auto}.contact-head{text-align:center;margin-bottom:28px}.contact-kicker{margin:0 0 10px;font-size:11px;font-weight:800;letter-spacing:.18em;color:var(--color-contact-kicker)}.contact-head h1{margin:0;font-size:clamp(34px,7vw,58px);letter-spacing:-.04em}.contact-lead{margin:16px auto 0;max-width:620px;line-height:1.9;color:var(--color-contact-lead)}.contact-chat-card{margin-top:34px;padding:34px;border:1px solid var(--color-contact-chat-card);border-radius:24px;background:var(--color-white);box-shadow:0 20px 55px var(--color-contact-chat-card-secondary)}.contact-chat-badge{display:inline-flex;align-items:center;justify-content:center;min-width:84px;height:30px;padding:0 13px;border-radius:999px;background:var(--color-discord-primary);color:var(--color-white);font-size:12px;font-weight:800;letter-spacing:.03em}.contact-chat-card h2{margin:0 0 12px;font-size:clamp(24px,5vw,34px)}.contact-chat-card p{margin:8px 0;color:var(--color-contact-chat-card-p);line-height:1.85}.contact-chat-start{display:flex;width:100%;min-height:58px;margin-top:26px;align-items:center;justify-content:center;border:0;border-radius:15px;background:var(--color-support-ink);color:var(--color-white);font-size:16px;font-weight:850;cursor:pointer;transition:transform .15s ease,opacity .15s ease}.contact-chat-start:hover{transform:translateY(-1px)}.contact-chat-start:disabled{opacity:.55;cursor:wait;transform:none}.contact-chat-card p.contact-status{min-height:1.5em;margin:14px 0 0;color:var(--color-contact-error);font-size:14px}.contact-notes{margin:26px 0 0;padding:22px 24px;border:1px solid var(--color-contact-notes);border-radius:18px;background:var(--color-contact-notes-secondary)}.contact-notes p{margin:7px 0;color:var(--color-contact-notes-p);line-height:1.75;font-size:14px}.contact-resume{margin-top:28px;padding-top:26px;border-top:1px solid var(--color-contact-resume)}.contact-resume h3{margin:0 0 8px;font-size:19px}.contact-resume-form{margin-top:18px}.contact-resume-form label{display:block;margin-bottom:8px;font-size:13px;font-weight:800;color:var(--color-contact-resume-form-label)}.contact-resume-row{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:10px}.contact-resume-row input{box-sizing:border-box;width:100%;min-height:50px;padding:0 14px;border:1px solid var(--color-contact-resume-row-input);border-radius:12px;background:var(--color-white);color:var(--color-support-ink);font:inherit;font-weight:800;letter-spacing:.06em;text-transform:uppercase;outline:none}.contact-resume-row input:focus{border-color:var(--color-contact-resume-row-input-focus);box-shadow:0 0 0 3px var(--color-discord-focus)}.contact-resume-row button{min-height:50px;padding:0 18px;border:0;border-radius:12px;background:var(--color-contact-resume-row-button);color:var(--color-contact-resume-row-button-secondary);font-weight:850;cursor:pointer}.contact-resume-row button:disabled{opacity:.55;cursor:wait}.contact-resume-help{margin-top:8px;font-size:12px;color:var(--color-contact-resume-help)}.contact-resume-status{min-height:1.4em;margin-top:8px;color:var(--color-contact-error);font-size:13px}.contact-x{display:block;margin-top:22px;padding:20px 22px;border:1px solid var(--color-contact-x);border-radius:18px;background:var(--color-white);color:var(--color-soft-black);text-decoration:none}.contact-x-row{display:flex;align-items:center;gap:12px}.contact-x-icon{display:grid;width:32px;height:32px;place-items:center;border-radius:9px;background:var(--color-soft-black);color:var(--color-white);font-weight:800}.contact-x-title{font-size:16px;font-weight:850}.contact-x-note{display:block;margin:8px 0 0 44px;color:var(--color-contact-x-note);font-size:13px}@media(max-width:640px){.contact-main{padding-left:14px;padding-right:14px}.contact-chat-card{padding:25px 20px;border-radius:20px}.contact-notes{padding:18px}.contact-resume-row{grid-template-columns:1fr}.contact-resume-row button{width:100%}.contact-x{padding:18px}.contact-x-note{margin-left:0;margin-top:12px}}
</style>
